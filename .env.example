# SecondBrain path configuration — copy to .env and fill in your values.
# Values here supplement process.env; if a key is already set in the environment it is NOT overridden.

# Root directory where secondbrain data lives (memory files, calls, transcripts, etc.)
# macOS:   SECONDBRAIN_ROOT=/Users/<username>/secondbrain
# Windows: SECONDBRAIN_ROOT=C:/Users/<username>/secondbrain
SECONDBRAIN_ROOT=/Users/<username>/secondbrain

# Claude models
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_SUMMARIZE_MODEL=claude-haiku-4-5-20251001

# Subprocess timeout in milliseconds (default: 300000 = 5 minutes)
CLAUDE_TIMEOUT_MS=300000

# (Windows only) Absolute path to git-bash. Set this if Claude Code cannot find bash.
# CLAUDE_CODE_GIT_BASH_PATH=C:\Users\<username>\Program Files\Git\usr\bin\bash.exe

# (Windows only) Explicit path to claude.cmd if it is not on PATH.
# CLAUDE_CMD_PATH=C:\Users\<username>\AppData\Roaming\npm\claude.cmd
